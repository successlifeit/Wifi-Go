rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             data.preferredLanguage in ['en', 'bn'] &&
             data.darkModeEnabled is bool &&
             data.notificationsEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserFavorite(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             (!('bssid' in data) || data.bssid == null || (data.bssid is string && data.bssid.size() <= 64)) &&
             data.securityType is string && data.securityType.size() >= 1 && data.securityType.size() <= 40 &&
             data.frequencyMhz is int && data.frequencyMhz >= 0 && data.frequencyMhz <= 7500 &&
             data.itemType in ['wifi_network', 'public_hotspot'] &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPublicHotspot(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.isPublic is bool &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.venueType in ['cafe', 'library', 'airport', 'park', 'coworking', 'transit', 'other'] &&
             data.address is string && data.address.size() >= 2 && data.address.size() <= 200 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.ssid is string && data.ssid.size() >= 1 && data.ssid.size() <= 64 &&
             data.securityType in ['Open', 'Captive Portal', 'WPA2', 'WPA3'] &&
             data.isFree is bool &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 400)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHotspotReview(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.hotspotId is string && isValidId(data.hotspotId) &&
             data.isPublic is bool &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidHotspotReport(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.hotspotId is string && isValidId(data.hotspotId) &&
             data.reason in ['offline', 'wrong_location', 'wrong_ssid', 'requires_payment', 'other'] &&
             data.details is string && data.details.size() >= 1 && data.details.size() <= 500 &&
             data.status in ['open', 'reviewed', 'resolved'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. User profiles (PII isolated strictly to owner)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'darkModeEnabled', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'preferredLanguage', 'darkModeEnabled', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'preferredLanguage', 'darkModeEnabled', 'notificationsEnabled', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // 2. User favorite WiFi networks and hotspots
      match /favorites/{favoriteId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'name', 'securityType', 'frequencyMhz', 'itemType', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'bssid', 'securityType', 'frequencyMhz', 'itemType', 'notes', 'createdAt', 'updatedAt']) &&
                         isValidUserFavorite(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         isValidUserFavorite(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bssid', 'securityType', 'frequencyMhz', 'itemType', 'notes', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && request.auth.uid == userId;
      }
    }

    // 3. Community Public WiFi Hotspots
    match /hotspots/{hotspotId} {
      allow get: if isSignedIn() && isValidId(hotspotId) && (existing().isPublic == true || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && (existing().isPublic == true || existing().ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(hotspotId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'isPublic', 'name', 'venueType', 'address', 'city', 'latitude', 'longitude', 'ssid', 'securityType', 'isFree', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'isPublic', 'name', 'venueType', 'address', 'city', 'latitude', 'longitude', 'ssid', 'securityType', 'isFree', 'notes', 'createdAt', 'updatedAt']) &&
                       isValidPublicHotspot(incoming());

      allow update: if isSignedIn() &&
                       isValidId(hotspotId) &&
                       isValidPublicHotspot(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isPublic', 'name', 'venueType', 'address', 'city', 'latitude', 'longitude', 'ssid', 'securityType', 'isFree', 'notes', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(hotspotId) && existing().ownerId == request.auth.uid;
    }

    // 4. Hotspot Reviews
    match /hotspot_reviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId) && (existing().isPublic == true || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (existing().isPublic == true || existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorName', 'hotspotId', 'isPublic', 'rating', 'comment', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'hotspotId', 'isPublic', 'rating', 'comment', 'createdAt']) &&
                       isValidHotspotReview(incoming()) &&
                       exists(/databases/$(database)/documents/hotspots/$(incoming().hotspotId));

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(reviewId) && existing().userId == request.auth.uid;
    }

    // 5. Hotspot Reports (owner-scoped read/write; terminal state protection)
    match /hotspot_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll(['userId', 'hotspotId', 'reason', 'details', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'hotspotId', 'reason', 'details', 'status', 'createdAt']) &&
                       isValidHotspotReport(incoming()) &&
                       exists(/databases/$(database)/documents/hotspots/$(incoming().hotspotId));

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidHotspotReport(incoming()) &&
                       existing().userId == request.auth.uid &&
                       existing().status != 'resolved' &&
                       incoming().userId == existing().userId &&
                       incoming().hotspotId == existing().hotspotId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'details']);

      allow delete: if isSignedIn() && isValidId(reportId) && existing().userId == request.auth.uid;
    }
  }
}
